{
  "name": "@deepwhale-cn/dsh-legal-notice",
  "version": "0.1.0",
  "description": "生成催告函、解除通知书、律师函骨架（Markdown + 打印版 HTML），字段占位、供人工审核",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "法律",
    "函件",
    "催告函",
    "解除通知"
  ],
  "files": [
    "lib",
    "skill",
    "bin",
    "cordis.patch.yml",
    "tests/fixtures",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-legal-notice": "bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-legal-notice.git"
  },
  "homepage": "https://deepwhale.org.cn/plugins.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-legal-notice/issues"
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1"
  }
}